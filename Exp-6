
import pandas as pd
import matplotlib.pyplot as plt

data = {
    'Year': [1980, 1990, 2000, 2010, 2020, 2025],
    'GDP Growth': [5.5, 3.2, 8.0, 10.3, 6.5, 6.3],
    'Inflation': [11.3, 8.9, 4.0, 9.5, 6.2, 4.9],
    'Exports': [5, 10, 20, 25, 35, 40],
    'Imports': [2, 5, 12, 20, 30, 39],
    'Interest Rate': [10, 12, 8, 7, 5, 6]
}

df = pd.DataFrame(data)

fig, ax = plt.subplots(3, 2, figsize=(14, 10))

ax[0, 0].plot(df['Year'], df['GDP Growth'], marker='o')
ax[0, 0].plot(df['Year'], df['Inflation'], marker='o')
ax[0, 0].set_title('GDP Growth and Inflation')
ax[0, 0].legend(['GDP Growth', 'Inflation'])

ax[0, 1].bar(df['Year'], df['Exports'])
ax[0, 1].set_title('Exports by Year')

ax[1, 0].scatter(df['GDP Growth'], df['Inflation'])
ax[1, 0].set_title('GDP Growth vs Inflation')

ax[1, 1].plot(df['Year'], df['Exports'], marker='o')
ax[1, 1].plot(df['Year'], df['Imports'], marker='o')
ax[1, 1].set_title('Exports and Imports')
ax[1, 1].legend(['Exports', 'Imports'])

ax[2, 0].bar(df['Year'], df['Interest Rate'])
ax[2, 0].set_title('Interest Rate by Year')

ax[2, 1].fill_between(df['Year'], df['GDP Growth'], alpha=0.5)
ax[2, 1].fill_between(df['Year'], df['Inflation'], alpha=0.5)
ax[2, 1].set_title('GDP Growth and Inflation Trend')

plt.tight_layout()
plt.show()

print(df)
